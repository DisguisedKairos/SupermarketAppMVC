<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <title>PayPal Checkout</title>
</head>
<body class="bg-light">
  <%- include("partials/navbar") %>

  <div class="container py-4">
    <div class="page-header mb-3">
      <div>
        <h2 class="mb-1">Pay with PayPal (Sandbox)</h2>
        <p class="text-muted mb-0">Invoice #<%= invoiceId %> — Total: $<%= Number(totalAmount).toFixed(2) %></p>
      </div>
      <div>
        <a href="/payment" class="btn btn-outline-secondary btn-sm">Back</a>
      </div>
    </div>

    <div id="errBox" class="alert alert-danger d-none"></div>

    <div class="card shadow-sm border-0">
      <div class="card-body">
        <p class="mb-3">
          Click the PayPal button below to complete your payment. This uses the PayPal JS SDK and your server endpoints:
          <code>/api/paypal/create-order</code> and <code>/api/paypal/capture-order</code>.
        </p>

        <div id="paypal-button-container"></div>
      </div>
    </div>
  </div>

  <script>
    const invoiceId = <%= JSON.stringify(invoiceId) %>;

    function showError(msg) {
      const el = document.getElementById('errBox');
      el.textContent = msg || 'Payment failed. Please try again.';
      el.classList.remove('d-none');
    }
  </script>

  <!-- PayPal JS SDK -->
  <script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=SGD"></script>

  <script>
    if (!window.paypal) {
      showError('PayPal SDK failed to load. Check your internet connection and PAYPAL_CLIENT_ID.');
    } else {
      paypal.Buttons({
        createOrder: async function () {
          const res = await fetch('/api/paypal/create-order', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ invoiceId })
          });

          const data = await res.json();
          if (!res.ok || !data.id) {
            throw new Error(data.error || 'Failed to create PayPal order.');
          }
          return data.id;
        },

        onApprove: async function (data) {
          const res = await fetch('/api/paypal/capture-order', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ invoiceId, orderId: data.orderID })
          });

          const result = await res.json();
          if (!res.ok || !result.ok) {
            throw new Error(result.error || 'Failed to capture PayPal order.');
          }

          window.location.href = `/invoice/${invoiceId}`;
        },

        onError: function (err) {
          console.error(err);
          showError(err && err.message ? err.message : 'Payment failed.');
        }
      }).render('#paypal-button-container');
    }
  </script>
</body>
</html>
