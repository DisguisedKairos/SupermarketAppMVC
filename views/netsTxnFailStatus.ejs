<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <title>Transaction Failed</title>
</head>
<body class="bg-light">
  <%- include("partials/navbar") %>

  <div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 720px;">
      <div class="card-body text-center">
        <img src="/images/redCross.png" alt="Failed" style="max-width: 140px;" class="mb-3" />
        <h3 class="mb-2">Transaction Failed</h3>
        <p class="text-muted mb-3"><%= message %></p>
        <p class="small text-muted mb-4">Invoice #<%= invoiceId %></p>

        <div class="d-flex gap-2 justify-content-center">
          <a href="/payment" class="btn btn-success">Try Again</a>
          <a href="/cart" class="btn btn-outline-secondary">Back to Cart</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
