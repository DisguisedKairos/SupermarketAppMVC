<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <title><%= title %></title>

  <!-- EventSource Polyfill (slides) -->
  <script src="https://unpkg.com/event-source-polyfill"></script>
</head>
<body class="bg-light">
  <%- include("partials/navbar") %>

  <div class="container py-4">
    <div class="page-header mb-3">
      <div>
        <h2 class="mb-1">NETS QR Payment</h2>
        <p class="text-muted mb-0">Invoice #<%= invoiceId %> — Total: $<%= Number(totalAmount).toFixed(2) %></p>
      </div>
      <div>
        <a href="/payment" class="btn btn-outline-secondary btn-sm">Back</a>
      </div>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body">
        <p class="mb-2">Scan this QR code using your bank app / simulator to complete payment.</p>
        <p id="status" class="text-muted">Waiting for payment...</p>

        <div class="row g-3 align-items-center">
          <div class="col-md-6">
            <img class="img-fluid border rounded" src="<%= qrCodeUrl %>" alt="NETS QR" />
          </div>
          <div class="col-md-6">
            <div class="p-3 bg-body-tertiary rounded">
              <div class="d-flex justify-content-between">
                <span>Transaction Ref</span>
                <code class="mb-0"><%= txnRetrievalRef %></code>
              </div>
              <hr>
              <div class="d-flex justify-content-between align-items-center">
                <span>Time remaining</span>
                <strong id="timer">05:00</strong>
              </div>
              <div class="mt-3">
                <small class="text-muted">This page uses SSE: <code>/sse/payment-status/:txnRetrievalRef</code>.</small>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-3">
          <img height="auto" width="260" src="/images/netsQrInfo.png" alt="NETS Info" />
        </div>
      </div>
    </div>
  </div>

  <script>
    let sse;
    const invoiceId = <%= JSON.stringify(invoiceId) %>;
    const txnRetrievalRef = <%= JSON.stringify(txnRetrievalRef) %>;

    const url = `/sse/payment-status/${encodeURIComponent(txnRetrievalRef)}`;

    // Slides show sending headers in EventSourcePolyfill. Our server does not require them,
    // but we keep them here to match the lesson pattern.
    const headers = {
      "api-key": <%= JSON.stringify(apiKey) %>,
      "project-id": <%= JSON.stringify(projectId) %>,
    };

    const statusEl = document.getElementById('status');

    function setStatus(msg) {
      statusEl.textContent = msg;
    }

    if (sse) sse.close();

    sse = new EventSourcePolyfill(url, {
      headers,
      heartbeatTimeout: 150000,
    });

    sse.addEventListener('message', (event) => {
      const data = JSON.parse(event.data || '{}');
      console.log('NETS SSE event:', data);

      if (data.success) {
        if (sse) sse.close();
        setStatus('Payment successful! Redirecting...');
        const targetInvoice = data.invoiceId || invoiceId;
        window.location.href = `/invoice/${targetInvoice}`;
        return;
      }

      if (data.fail) {
        if (sse) sse.close();
        setStatus('Payment failed or timed out.');
        window.location.href = `/netsqr/fail/${invoiceId}`;
        return;
      }

      setStatus('Waiting for payment confirmation...');
    });

    // Countdown Timer (5 minutes)
    const timerElement = document.getElementById('timer');
    let remainingTime = 300;

    const updateTimer = () => {
      const minutes = Math.floor(remainingTime / 60);
      const seconds = remainingTime % 60;
      timerElement.textContent = `${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;
      remainingTime--;

      if (remainingTime < 0) {
        clearInterval(timerInterval);
        timerElement.textContent = '00:00';
        setStatus('Transaction timed out.');
        if (sse) sse.close();
        window.location.href = `/netsqr/fail/${invoiceId}`;
      }
    };

    const timerInterval = setInterval(updateTimer, 1000);
    updateTimer();
  </script>
</body>
</html>
