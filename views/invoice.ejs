<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Custom Cold Storage–style theme -->
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>UnFairPrice - Invoice</title>
</head>
<body class="bg-light">
  <%- include("partials/navbar") %>

<div class="container py-4">
    <div class="page-header mb-3">
      <div>
        <h2 class="mb-1">Invoice</h2>
        <p class="text-muted mb-0">Thank you for shopping with UnFairPrice.</p>
      </div>
      <div>
        <a href="/history" class="btn btn-outline-secondary btn-sm">View all orders</a>
      </div>
    </div>
    <div class="row mb-4 cs-animate" data-animate-delay="1">
      <div class="col-md-6">
        <h5 class="mb-3">Invoice details</h5>
        <% if (typeof paymentMethod !== 'undefined' && paymentMethod) { %>
          <p class="mb-2"><strong>Payment Method:</strong> <%= paymentMethod %></p>
        <% } %>
        <% if (header && header.status) { %>
          <p class="mb-2"><strong>Status:</strong> <%= header.status %></p>
        <% } %>
        <% if (header && header.paidAt) { %>
          <p class="mb-2"><strong>Paid At:</strong> <%= new Date(header.paidAt).toLocaleString() %></p>
        <% } %>
        <% if (header && header.providerRef) { %>
          <div class="mb-2">
            <strong>Transaction Ref:</strong>
            <span id="txn-ref"><%= header.providerRef %></span>
            <button type="button" class="btn btn-sm btn-outline-secondary ms-2" onclick="copyTxnRef()">Copy</button>
          </div>
          <script>
            function copyTxnRef() {
              const el = document.getElementById('txn-ref');
              if (!el) return;
              const text = el.textContent || '';
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text);
              } else {
                const area = document.createElement('textarea');
                area.value = text;
                document.body.appendChild(area);
                area.select();
                document.execCommand('copy');
                document.body.removeChild(area);
              }
            }
          </script>
        <% } %>
        <% if (header && header.refundStatus && header.refundStatus !== 'NONE') { %>
          <p class="mb-2"><strong>Refund Status:</strong> <%= header.refundStatus %> ($<%= Number(header.refundedAmount || 0).toFixed(2) %>)</p>
        <% } %>
        <% if (header && header.voidedAt) { %>
          <p class="mb-2"><strong>Voided At:</strong> <%= new Date(header.voidedAt).toLocaleString() %></p>
        <% } %>
        <p class="mb-1"><strong>Invoice ID:</strong> <%= header.id %></p>
        <p class="mb-1"><strong>Date:</strong>
          <% const created = header.createdAt instanceof Date ? header.createdAt : new Date(header.createdAt); %>
          <%= created.toLocaleString() %>
        </p>
      </div>
      <div class="col-md-6 text-md-end">
        <h5 class="mb-1">Billed To:</h5>
        <p class="mb-0"><strong><%= user.username %></strong></p>
        <% if (user.address) { %><p class="mb-0"><%= user.address %></p><% } %>
        <% if (user.contact) { %><p class="mb-0">Contact: <%= user.contact %></p><% } %>
      </div>
    </div>

    <% const _statusHistory = typeof statusHistory !== 'undefined' ? statusHistory : []; %>
    <% const _refunds = typeof refunds !== 'undefined' ? refunds : []; %>

    <div class="table-responsive mb-3">
      <table class="table table-striped table-hover align-middle bg-white shadow-sm">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Product</th>
            <th class="text-center">Quantity</th>
            <th class="text-end">Unit Price</th>
            <th class="text-end">Line Total</th>
          </tr>
        </thead>
        <tbody>
          <% for (let i = 0; i < items.length; i++) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= items[i].productName %></td>
              <td class="text-center"><%= items[i].quantity %></td>
              <td class="text-end">$<%= items[i].price.toFixed(2) %></td>
              <td class="text-end">$<%= (items[i].price * items[i].quantity).toFixed(2) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="row justify-content-end">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between"><span>Subtotal:</span><strong>$<%= header.subtotal.toFixed(2) %></strong></div>
            <div class="d-flex justify-content-between"><span>Tax:</span><strong>$<%= header.tax.toFixed(2) %></strong></div>
            <hr>
            <div class="d-flex justify-content-between"><span>Total:</span><strong class="fs-5 text-success">$<%= header.totalAmount.toFixed(2) %></strong></div>
          </div>
        </div>
      </div>
    </div>

    <% if (_statusHistory && _statusHistory.length) { %>
      <div class="mt-4">
        <h5 class="mb-2">Payment Status History</h5>
        <div class="table-responsive">
          <table class="table table-sm align-middle bg-white shadow-sm">
            <thead class="table-light">
              <tr>
                <th>Status</th>
                <th>Note</th>
                <th>Actor</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              <% _statusHistory.forEach(function(h) { %>
                <tr>
                  <td><%= h.status %></td>
                  <td><%= h.note || '' %></td>
                  <td><%= h.actorRole ? `${h.actorRole}#${h.actorUserId || ''}` : '' %></td>
                  <td><%= new Date(h.createdAt).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <% if (_refunds && _refunds.length) { %>
      <div class="mt-4">
        <h5 class="mb-2">Refunds</h5>
        <div class="table-responsive">
          <table class="table table-sm align-middle bg-white shadow-sm">
            <thead class="table-light">
              <tr>
                <th>Amount</th>
                <th>Reason</th>
                <th>By</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              <% _refunds.forEach(function(r) { %>
                <tr>
                  <td>$<%= Number(r.amount || 0).toFixed(2) %></td>
                  <td><%= r.reason || '' %></td>
                  <td><%= r.createdByUserId ? `admin#${r.createdByUserId}` : '' %></td>
                  <td><%= new Date(r.createdAt).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <% if (user && user.role === 'admin') { %>
      <div class="mt-4">
        <h5 class="mb-2">Admin: Issue Refund</h5>
        <div class="card border-0 shadow-sm">
          <div class="card-body">
            <form method="post" action="/admin/invoices/<%= header.id %>/refund">
              <input type="hidden" name="userId" value="<%= header.userId %>">
              <div class="row g-3 align-items-end">
                <div class="col-md-4">
                  <label class="form-label">Amount</label>
                  <input type="number" name="amount" class="form-control" step="0.01" min="0.01" placeholder="0.00" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Reason</label>
                  <input type="text" name="reason" class="form-control" placeholder="Optional reason">
                </div>
                <div class="col-md-2 d-grid">
                  <button type="submit" class="btn btn-danger">Refund</button>
                </div>
              </div>
              <div class="form-text mt-2">Refunds are credited to the customer's e-wallet.</div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

    <div class="mt-4 d-flex flex-wrap gap-2">
      <% if (header && ['FAILED', 'CANCELLED', 'PENDING_PAYMENT'].includes(String(header.status || '')) && ['PayPal', 'Stripe', 'NETSQR'].includes(String(header.paymentMethod || ''))) { %>
        <a href="/payment/retry/<%= header.id %>" class="btn btn-warning">Retry Payment</a>
      <% } %>
      <a href="/shopping" class="btn btn-primary">Continue Shopping</a>
      <a href="/" class="btn btn-outline-secondary">Back to Home</a>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
