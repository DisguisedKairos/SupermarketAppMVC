<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Transaction Successful</title>
</head>
<body class="bg-light">
  <%- include("partials/navbar") %>

  <div class="container py-4">
    <div class="page-header mb-3">
      <div>
        <h2 class="mb-1"><%= message %></h2>
        <p class="text-muted mb-0">Thank you for your payment. Your order is being prepared.</p>
      </div>
      <div>
        <a href="/history" class="btn btn-outline-secondary btn-sm">View all orders</a>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="row align-items-center g-4">
          <div class="col-md-8">
            <h5 class="mb-2">NETS QR payment confirmed</h5>
            <p class="text-muted mb-3">Keep this page for your records. You can view your invoice and payment status anytime.</p>

            <% if (invoiceId || paymentMethod) { %>
              <div class="mb-3">
                <% if (invoiceId) { %>
                  <div><strong>Invoice ID:</strong> <%= invoiceId %></div>
                <% } %>
                <% if (paymentMethod) { %>
                  <div><strong>Payment Method:</strong> <%= paymentMethod %></div>
                <% } %>
              </div>
            <% } %>

            <div class="d-flex flex-wrap gap-2">
              <% if (invoiceId) { %>
                <a href="/invoice/<%= invoiceId %>" class="btn btn-success">View Invoice</a>
              <% } %>
              <a href="/shopping" class="btn btn-primary">Continue Shopping</a>
              <a href="/" class="btn btn-outline-secondary">Back to Home</a>
            </div>
          </div>

          <div class="col-md-4 text-md-end">
            <img src="/images/greenTick.png" alt="Payment success tick" class="img-fluid" style="max-width: 140px;">
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
